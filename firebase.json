{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "database": { "rules": "database.rules.json" },
  "storage": { "rules": "storage.rules" },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "voltrike-v2",
          "appId": "1:327670792817:android:9ce6477d6ed8f1a1c5d1d0",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "voltrike-v2",
          "configurations": {
            "android": "1:327670792817:android:9ce6477d6ed8f1a1c5d1d0",
            "ios": "1:327670792817:ios:67a43da5ccd96512c5d1d0",
            "macos": "1:327670792817:ios:67a43da5ccd96512c5d1d0",
            "web": "1:327670792817:web:d694dafb0cfcce03c5d1d0",
            "windows": "1:327670792817:web:aeb69a6c9f946f85c5d1d0"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "admin/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/firebase-messaging-sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          }
        ]
      },
      {
        "source": "/images/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=604800"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "functions": { "host": "127.0.0.1", "port": 5001 },
    "firestore": { "host": "127.0.0.1", "port": 8080 },
    "database": { "host": "127.0.0.1", "port": 9000 },
    "storage": { "host": "127.0.0.1", "port": 9199 },
    "ui": { "enabled": true, "host": "127.0.0.1", "port": 4000 },
    "singleProjectMode": true
  }
}
