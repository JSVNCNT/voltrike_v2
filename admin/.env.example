# Public Mapbox browser token. Create a URL-restricted token for the deployed domain.
VITE_MAPBOX_ACCESS_TOKEN=INSERT_MAPBOX_ACCESS_TOKEN_HERE
VITE_VOLTRIKE_API_BASE_URL=http://127.0.0.1:8080
VITE_FIREBASE_APP_CHECK_SITE_KEY=INSERT_RECAPTCHA_V3_SITE_KEY
VITE_FIREBASE_PROJECT_ID=INSERT_FIREBASE_PROJECT_ID
VITE_FIREBASE_API_KEY=INSERT_PUBLIC_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=INSERT_PROJECT.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=INSERT_PROJECT.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=INSERT_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=INSERT_FIREBASE_WEB_APP_ID
VITE_SENTRY_DSN=INSERT_PUBLIC_SENTRY_DSN_HERE
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05

# Build-only Sentry settings. SENTRY_AUTH_TOKEN is private and belongs only in
# Render/GitHub secrets; never prefix it with VITE_.
SENTRY_ORG=voltrike
SENTRY_PROJECT=voltrike-admin
SENTRY_AUTH_TOKEN=INSERT_PRIVATE_BUILD_TOKEN_HERE

# Firebase Console > Project settings > Cloud Messaging > Web Push certificates.
# This is the public VAPID key, not a server credential.
VITE_FIREBASE_VAPID_KEY=INSERT_FIREBASE_WEB_PUSH_VAPID_KEY_HERE
