# Public Mapbox browser token. Create a URL-restricted token for the deployed domain.
VITE_MAPBOX_ACCESS_TOKEN=INSERT_MAPBOX_ACCESS_TOKEN_HERE
VITE_VOLTRIKE_API_BASE_URL=http://127.0.0.1:8080
VITE_FIREBASE_APP_CHECK_SITE_KEY=INSERT_RECAPTCHA_V3_SITE_KEY

# Firebase Console > Project settings > Cloud Messaging > Web Push certificates.
# This is the public VAPID key, not a server credential.
VITE_FIREBASE_VAPID_KEY=INSERT_FIREBASE_WEB_PUSH_VAPID_KEY_HERE
