rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function developerAdmin() {
      return signedIn() && request.auth.token.adminRole == 'developer_admin';
    }
    function todaAdminForDriver(uid) {
      return signedIn() &&
        request.auth.token.adminRole == 'toda_admin' &&
        firestore.exists(/databases/(default)/documents/drivers/$(uid)) &&
        firestore.get(/databases/(default)/documents/drivers/$(uid)).data.todaId ==
          request.auth.token.todaId;
    }
    function pendingTodaApplicant(todaId) {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/todaApplications/$(todaId)) &&
        firestore.get(/databases/(default)/documents/todaApplications/$(todaId)).data.adminUid == request.auth.uid &&
        firestore.get(/databases/(default)/documents/todaApplications/$(todaId)).data.status == 'pending';
    }

    match /drivers/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid ||
        fileName == 'profile.jpg' || developerAdmin() || todaAdminForDriver(uid));
      allow create, update, delete: if false;
    }

    match /passengers/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || fileName == 'profile.jpg');
      allow create, update, delete: if false;
    }

    // V2 clients upload only to their own staging namespace. Go verifies the
    // object generation/type/hash and copies it to an immutable final path.
    match /staging/{uid}/{uploadId}/{fileName} {
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.size < 10 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') ||
          request.resource.contentType == 'application/pdf');
      allow read, update, delete: if false;
    }

    // Legacy direct TODA paths are read-only during the resettable capstone
    // cutover. All new legal evidence is finalized by Go under /final.
    match /toda_documents/{todaId}/{fileName} {
      allow read: if developerAdmin() || pendingTodaApplicant(todaId);
      allow write: if false;
    }

    match /final/todas/{todaId}/{field}/{fileName} {
      allow read: if developerAdmin() || pendingTodaApplicant(todaId);
      allow write: if false;
    }

    match /final/profiles/{uid}/{field}/{fileName} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /final/drivers/{uid}/{field}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid ||
        developerAdmin() || todaAdminForDriver(uid));
      allow write: if false;
    }

    // Existing profile URLs created before path standardization remain usable.
    // New writes are intentionally prohibited in these legacy folders.
    match /driver_profiles/{fileName} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /passenger_profiles/{fileName} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
