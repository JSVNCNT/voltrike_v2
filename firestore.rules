rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function developerAdmin() {
      return signedIn() &&
        request.auth.token.adminRole == 'developer_admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'developer_admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }
    function todaAdmin() {
      return signedIn() &&
        request.auth.token.adminRole == 'toda_admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'toda_admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.todaId == request.auth.token.todaId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }
    function adminTodaId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.todaId;
    }
    function todaAdminFor(todaId) {
      return todaAdmin() && adminTodaId() == todaId;
    }
    function bookingMember(bookingId) {
      return signedIn() && request.auth.uid in [
        get(/databases/$(database)/documents/bookings/$(bookingId)).data.passengerId,
        get(/databases/$(database)/documents/bookings/$(bookingId)).data.driverId
      ];
    }
    function offeredDriver(bookingId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/drivers/$(request.auth.uid)/bookingOffers/$(bookingId)) &&
        get(/databases/$(database)/documents/drivers/$(request.auth.uid)/bookingOffers/$(bookingId)).data.status == 'offered' &&
        get(/databases/$(database)/documents/drivers/$(request.auth.uid)/bookingOffers/$(bookingId)).data.expiresAt > request.time;
    }
    function driverViolationMember(violationId) {
      return signedIn() && (
        get(/databases/$(database)/documents/driverViolations/$(violationId)).data.driverId == request.auth.uid ||
        developerAdmin() ||
        todaAdminFor(
          get(/databases/$(database)/documents/driverViolations/$(violationId)).data.ownerTodaId
        )
      );
    }
    match /users/{uid} {
      // Passenger identity is disclosed only by the scoped, audited Go API.
      allow read: if signedIn() && (request.auth.uid == uid ||
        (resource.data.role != 'passenger' && (developerAdmin() ||
          (todaAdmin() && resource.data.todaId == adminTodaId()))));
      // Roles, TODA assignment, and account activity are privileged state and
      // cannot be changed by the account holder.
      allow create, update: if false;
      allow delete: if false;
      match /devices/{token} {
        allow read: if signedIn() && request.auth.uid == uid;
        // Administrator browser-token ownership is managed only by trusted
        // callables and the SHA-256 ownership registry. Passenger and driver
        // apps retain their existing self-registration path.
        allow write: if signedIn() && request.auth.uid == uid &&
          !(get(/databases/$(database)/documents/users/$(uid)).data.role in
            ['developer_admin', 'toda_admin']);
      }
      match /emergencyContacts/{contactId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 100 &&
          request.resource.data.phoneNumber is string &&
          request.resource.data.phoneNumber.size() >= 7 &&
          request.resource.data.phoneNumber.size() <= 30 &&
          request.resource.data.relationship is string &&
          request.resource.data.relationship.size() <= 50;
      }
    }
    match /activePassengerBookings/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /passengerBookingPolicies/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /passengerCancellationEvents/{bookingId} {
      allow read: if signedIn() && resource.data.passengerId == request.auth.uid;
      allow write: if false;
    }
    match /bookingOperations/{operationId} {
      allow read, write: if false;
    }
    match /bookingCalls/{bookingId} {
      // Direct call-state listeners are authorized from the booking, so the
      // caller may subscribe safely even before the call document exists.
      allow get: if bookingMember(bookingId);
      // Durable incoming-call discovery is constrained to the recipient.
      allow list: if signedIn() &&
        resource.data.recipientId == request.auth.uid;
      allow write: if false;
    }
    match /auditLogs/{auditId} {
      allow read: if developerAdmin();
      allow write: if false;
    }
    match /adminAuditLogs/{auditId} {
      allow read: if developerAdmin();
      allow write: if false;
    }
    match /adminWebPushTokens/{tokenHash} {
      // Browser-token ownership is transferred atomically by trusted callable
      // functions. Raw tokens are never stored in this registry and clients
      // cannot forge or inspect ownership records directly.
      allow read, write: if false;
    }
    // Passenger profile data is kept separate from the public user identity.
    // The passenger may maintain their own profile; admins can audit it.
    match /passengers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if false;
      allow delete: if false;
    }
    match /drivers/{driverId}/bookingOffers/{offerId} {
      allow read: if signedIn() && request.auth.uid == driverId;
      allow write: if false;
    }
    match /drivers/{driverId} {
      // Driver onboarding and safe profile updates operate on the
      // authenticated driver's own document. Online, eligibility, and active
      // booking state are backend-authoritative.
      allow create: if false;
      // Developers can audit every registration. A TODA administrator can
      // inspect and decide only applications assigned to their TODA.
      allow read: if signedIn() && (request.auth.uid == driverId ||
        developerAdmin() || todaAdminFor(resource.data.todaId));
      allow update: if false;
      allow delete: if false;
    }
    match /vehicles/{vehicleId} {
      allow create: if false;
      allow read: if signedIn() && (resource.data.driverId == request.auth.uid || developerAdmin() ||
        todaAdminFor(get(/databases/$(database)/documents/drivers/$(resource.data.driverId)).data.todaId));
      allow update, delete: if false;
    }
    // Driver registration happens before Firebase Authentication creates the
    // new driver account, so the public TODA directory must be readable while
    // anonymous. Legal details and document URLs live separately in the
    // developer-only todaApplications collection below.
    match /todas/{todaId} {
      allow read: if true;
      allow write: if false;
    }
    // Legal TODA registration fields and evidence URLs are never placed on
    // the public TODA record used by driver registration.
    match /todaApplications/{todaId} {
      allow read: if developerAdmin();
      allow write: if false;
    }
    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /geofences/{todaId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /routeRestrictions/{restrictionId} {
      // Mobile route selection needs the active restrictions. Only the
      // developer-admin callable functions may create or change them.
      allow read: if signedIn();
      allow write: if false;
    }
    match /driverRestrictionStates/{driverId} {
      // Polygon transition state and deduplication are backend-owned. A
      // client cannot reset an entry state to manufacture or suppress cases.
      allow read, write: if false;
      match /restrictions/{restrictionId} {
        allow read, write: if false;
      }
    }
    match /driverViolations/{violationId} {
      // Cases and response fields are created and mutated only by callable
      // functions. Direct reads are limited to the driver, developer admins,
      // and the administrator of the driver's owning TODA. Passengers are
      // deliberately excluded even when a bookingId is present.
      allow read: if signedIn() && (
        resource.data.driverId == request.auth.uid ||
        developerAdmin() ||
        todaAdminFor(resource.data.ownerTodaId)
      );
      allow write: if false;
      match /messages/{messageId} {
        allow read: if driverViolationMember(violationId);
        allow write: if false;
      }
    }
    match /zoneRequests/{requestId} {
      allow read: if developerAdmin() || todaAdminFor(resource.data.todaId);
      allow write: if false;
    }
    match /chat/{bookingId} {
      allow read: if bookingMember(bookingId);
      allow create, update: if false;
      match /messages/{messageId} {
        allow read: if bookingMember(bookingId);
        allow create, update: if false;
      }
      match /typing/{userId} {
        allow read: if bookingMember(bookingId);
        allow create, update, delete: if false;
      }
    }
    // Chat safety configuration and evidence contain sensitive phrases and
    // unmasked message content. They are available only through audited Go
    // System Admin operations, never through direct client SDK reads/writes.
    match /chatModerationRules/{ruleId} {
      allow read, write: if false;
    }
    match /chatModerationIncidents/{incidentId} {
      allow read, write: if false;
    }
    match /reports/{reportId} {
      // Participant identity and TODA scope are derived by createRideReport.
      allow create: if false;
      allow read: if signedIn() && resource.data.reporterId == request.auth.uid;
      allow update, delete: if false;
    }
    match /safetyIncidents/{incidentId} {
      allow read: if signedIn() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );
      allow write: if false;
    }
    match /settlements/{bookingId} {
      allow read: if bookingMember(bookingId);
      allow write: if false;
    }
    match /ratings/{ratingId} {
      allow create: if false;
      allow read: if signedIn() &&
        (resource.data.passengerId == request.auth.uid || resource.data.driverId == request.auth.uid);
      allow update, delete: if false;
    }
    match /bookings/{bookingId} {
      // Durable booking mutations are server-authoritative Cloud Function
      // transactions. Mobile clients retain member/offer read access only.
      allow create: if false;
      allow read: if (signedIn() && (resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid)) || offeredDriver(bookingId);
      allow update: if false;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
