# Local emulator-only values. Never copy production secrets here.
PORT=8080
GOOGLE_CLOUD_PROJECT=demo-voltrike
FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-voltrike-default-rtdb
FIREBASE_STORAGE_BUCKET=demo-voltrike.appspot.com
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
GOOGLE_ROUTES_API_KEY=replace-with-a-restricted-development-key
GO_QUOTE_ENCRYPTION_KEY=replace-with-base64url-encoded-32-byte-key
GO_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
GO_REQUIRE_APP_CHECK=false
GO_ALLOW_UNAUTHENTICATED_LOCAL=true
LIVEKIT_SERVER_URL=wss://replace-with-your-livekit-host
LIVEKIT_API_KEY=replace-with-local-livekit-key
LIVEKIT_API_SECRET=replace-with-local-livekit-secret
DEVELOPER_BOOTSTRAP_CODE=replace-with-local-bootstrap-code
