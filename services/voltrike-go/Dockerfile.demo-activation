FROM golang:1.26-bookworm AS build
WORKDIR /src
ENV GOWORK=off
COPY go.mod go.sum ./
RUN go mod download
COPY internal ./internal
COPY cmd/demo-activation ./cmd/demo-activation
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/demo-activation ./cmd/demo-activation

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/demo-activation /demo-activation
ENTRYPOINT ["/demo-activation"]
